{
  "manifest_version": 3,
  "name": "Jev — Ask This Page",
  "version": "0.3.0",
  "description": "Native Chrome side panel chatbot that evaluates web pages using TypeSafe Jev and highlights answers.",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Jev Side Panel"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}